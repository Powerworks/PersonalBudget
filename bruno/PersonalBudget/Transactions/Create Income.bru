meta {
  name: Create Income
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

body:json {
  {
    "type": "INCOME",
    "amount": 2000.00,
    "category": "salary",
    "description": "monthly pay",
    "occurredOn": "2026-08-01"
  }
}

docs {
  Records an income entry in the transaction module.
  Publishes a TransactionRecorded event that the budget and summary
  modules react to asynchronously.
}

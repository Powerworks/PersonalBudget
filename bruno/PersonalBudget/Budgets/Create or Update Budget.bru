meta {
  name: Create or Update Budget
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

body:json {
  {
    "category": "groceries",
    "monthlyLimit": 100.00
  }
}

docs {
  Creates a budget limit for a category, or updates it if one already
  exists for that category (category is unique).
}
